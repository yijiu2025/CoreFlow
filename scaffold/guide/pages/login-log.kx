@ref ../models/api.kx
@ref ../models/system.kx
@ref ../components/shared.kx

@page /monitor/login-log (登录日志) extends Main {
  @icon LogIn
  @meta title="登录日志"

  @header 页头 {
    @text 标题 (bind: '登录日志')
    @button 导出 { @navigate click -> @action exportLogs }
    @permission admin:log:remove
    @button 清空 { @navigate click -> @modal 清空确认 }
  }

  @detail 概览读数 {
    @stat 总次数 (bind: loginStats.total)
    @stat 成功率 (bind: loginStats.successRate)
    @stat 登录账号 (bind: loginStats.users)
    @stat 来源 IP (bind: loginStats.ips)
  }

  @tab 呈现 {
    @menu 趋势 { @navigate click -> @state mode = 'trend' }
    @menu 热力 { @navigate click -> @state mode = 'heat' }
  }

  @detail 趋势图 {
    @render when: mode === 'trend'
    @detail 折线 {
      @prop series: StatsBucket[]
      @prop height: number
    }
  }

  @detail 热力格 {
    @render when: mode === 'heat'
    @detail 7×24 网格 {
      @prop cells: object[]
      @prop threshold: number
    }
    @button 近 7 天 { @navigate click -> @state heatDays = 7 }
    @button 近 30 天 { @navigate click -> @state heatDays = 30 }
  }

  @detail 异常聚合 {
    @list 异常来源 {
      @card 异常项 (v-for: item in anomalies) {
        @text 来源 (bind: item.key)
        @stat 失败次数 (bind: item.failed)
        @stat 涉及账号 (bind: item.spread)
        @text 最近时间 (bind: item.lastTime)
      }
      @empty { @text 该时段没有集中失败来源 }
    }
  }

  @detail 明细 {
    @input 关键词 (bind: query.keyword)
    @input 事件 (bind: query.event)
    @input 时间范围 (bind: query.range)
    @list 日志列表 {
      @card 登录行 (v-for: row in loginLogPage.rows) {
        @text 时间 (bind: row.createdAt)
        @text 账号 (bind: row.username)
        @text 事件 (bind: row.event)
        @text 来源 IP (bind: row.ip)
        @text 归属地 (bind: row.location)
        @badge 结果 (bind: row.event)
      }
      @empty { @text 该条件下没有登录记录 }
    }
  }

  @modal 清空确认 {
    @text 提示 (bind: '清空将删除全部登录日志，不可恢复')
    @button 确认清空 { @navigate click -> @action clearLogs }
  }

  @state mode: string = 'trend'
  @state heatDays: number = 7
  @state query: object = {}
  @state loginStats: object = {}
  @state heatmap: object = {}
  @state loginLogPage: object = {}

  @api GET /admin/console/v1/login-logs (query: pageNum, pageSize, keyword, event, startTime, endTime) -> loginLogPage
  @api GET /admin/console/v1/login-logs/stats (query: range) -> loginStats
  @api GET /admin/console/v1/login-logs/heatmap (query: days) -> heatmap
  @api DELETE /admin/console/v1/login-logs/:id (bind: id)
  @api DELETE /admin/console/v1/login-logs

  @sync anomalies = heatmap.anomalies

  @note 数据源 session_logs，与 oauth21 会话日志同源，不另建表
  @note 热力格按对角线波纹级联点亮；失败占比高者斜线填充
  @note 异常阈值取后端 heatmap 返回的 threshold，前端不硬编码
}
