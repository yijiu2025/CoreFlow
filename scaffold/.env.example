# 复制为 .env.development 后按需修改

# 开发端口（strictPort：被占直接报错，不自动换端口）
VITE_PORT=5175

# 主题目录（skinsuite 扫描入口，缺省 src/theme）
VITE_THEME_DIR=src/theme

# 后端地址（vite 代理目标：/admin、/auth、/user）
VITE_API_TARGET=http://127.0.0.1:3000

# oauth21 登录页地址（iframe SSO，必须是浏览器可直达地址）
# ⚠️ admin/ 与 oauth21/ 默认都用 5174，同时启动时请改这里指向 oauth21 实际端口
VITE_SSO_URL=http://localhost:5174

# 登录页外观（可选）：oauth21 的主题机制按 ?th / ?th_color 解析，
# 留空 = 用 oauth21 的包声明与用户偏好，不传参数。
#   VITE_SSO_THEME_VIEW   版式 ≡ 主题包名（oauth21/src/theme/themes/<pkg>）
#                         default = 宽卡片左右品牌栏；paper = 窄幅单列「票据」
#   VITE_SSO_THEME_COLOR  配色 id（themes/<pkg>/mini/login/colors/<id>，如 white / black）
#
# 本应用自己的登录页也支持同一套开关（浏览器地址栏直接试）：
#   /login?th=default            居中承台（默认）
#   /login?th=spotlight          左深右浅：叙事面板 + 登录卡
#   /login?th_color=black        深色
# VITE_SSO_THEME_VIEW=default
# VITE_SSO_THEME_COLOR=
