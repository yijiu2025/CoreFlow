{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "stable-deviceid": [
        "../packages/shared-device/src/index.ts"
      ],
      "skinsuite": [
        "../packages/theme-core/src/index.ts"
      ],
      "skinsuite/vue": [
        "../packages/theme-core/src/vue/index.ts"
      ],
      "skinsuite/vite": [
        "../packages/theme-core/src/vite/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "env.d.ts"
  ]
}
