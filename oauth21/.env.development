VITE_API_BASE_URL=http://localhost:3000
VITE_APP_TITLE=Enterprise Identity System

# --- 人机验证（hCaptcha，与后端 .env 的 RECAPTCHA_ENABLED 对应）---
VITE_RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_SITE_KEY=649e9b18-031a-4610-a682-ca7a257ed726

# --- 密码重置方式（与后端 .env 的 PASSWORD_RESET_MODE 对应）---
# code：验证码重置（默认）/ link：邮件链接重置
VITE_PASSWORD_RESET_MODE=code

# --- iframe 嵌入方（父应用）origin 白名单，逗号分隔 ---
# 用途：oauth21 被嵌在别的 app 弹窗 iframe 里时，只在父 origin 命中白名单的情况下
#       才 postMessage（SSO_READY / 主题同步）—— 防恶意页面嵌入窃 sessionToken。
# 🔴 漏配的症状：宿主弹窗「正在加载安全登录」要等满 3s 兜底超时（SSO_READY 被拒发，
#    宿主收不到握手），控制台见「[SSO] 拒绝 postMessage：父 origin 未授权 <origin>」。
# 本地开发常用的宿主 origin 都列上（posecraft 跑 5176；*.localhost 走 allowedHosts）。
# ⚠️ 别把 oauth21 自己的端口（5174 / 5175）写进来 —— 那是被嵌方，不是父应用。
VITE_ALLOWED_PARENT_ORIGINS='http://localhost:5176,http://127.0.0.1:5176,http://posecraft.localhost:5176,http://aaa.localhost:5176'

# --- 请求签名 appKey（前后端共享，后端 .env 的 SIGN_APP_KEY 必须相同）---
# 弱防爬用：前端反编译可拿到，真正敏感操作靠登录态+权限校验
VITE_SIGN_APP_KEY=coreflow-sign-key-2026-change-me

# --- 第三方登录（社交登录）---
# 授权端点：**只接受站内相对路径**（/ 开头且非 //）。刻意不支持绝对地址与协议相对
# 地址 —— 端点一旦能由外部指定，"把用户送去任意外域"就从漏洞变成了配置问题。
# 未配置时点了不会静默失败，而是提示"尚未配置授权地址"。
VITE_SOCIAL_ENDPOINT=

# 默认显示哪几个 provider（逗号分隔）：wechat,alipay,qq,weibo,github,apple
# 单次会话可用 URL 参数覆盖：?social=wechat,qq（联调最方便）
# 留空 = 登录页不渲染第三方登录行（默认外观零变化）
VITE_SOCIAL_PROVIDERS=