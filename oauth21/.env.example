VITE_API_BASE_URL=http://localhost:3000
VITE_APP_TITLE=Enterprise Identity System

# --- 人机验证（hCaptcha，与后端 .env 的 RECAPTCHA_ENABLED 对应）---
VITE_RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_SITE_KEY=

# --- 密码重置方式（与后端 .env 的 PASSWORD_RESET_MODE 对应）---
# code：验证码重置（默认）/ link：邮件链接重置
VITE_PASSWORD_RESET_MODE=code

VITE_ALLOWED_PARENT_ORIGINS='http://aaa.localhost:5176,http://localhost:5175'

# --- 请求签名 appKey（前后端共享，后端 .env 的 SIGN_APP_KEY 必须相同）---
# 弱防爬用：前端反编译可拿到，真正敏感操作靠登录态+权限校验
VITE_SIGN_APP_KEY=coreflow-sign-key-2026-change-me
# --- 人机验证（Cloudflare Turnstile，推荐国内/隐私场景）---
# 加载比 hCaptcha 快（~50KB vs ~200KB），国内访问 ~200ms
# Turnstile 优先于 hCaptcha（同时开启时 Turnstile 生效）
# VITE_TURNSTILE_ENABLED=false
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...   (从 Cloudflare Dashboard 获取)
