VITE_API_BASE_URL=http://localhost:3000
VITE_APP_TITLE=Enterprise Identity System

# --- 人机验证（hCaptcha，与后端 .env 的 RECAPTCHA_ENABLED 对应）---
VITE_RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_SITE_KEY=

# --- 密码重置方式（与后端 .env 的 PASSWORD_RESET_MODE 对应）---
# code：验证码重置（默认）/ link：邮件链接重置
VITE_PASSWORD_RESET_MODE=code
