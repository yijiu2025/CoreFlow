# ============================================================================
# Docker 部署环境变量模板
#
#   cp .env.docker.example .env.docker
#   # 改掉所有 change-me / your-* 的值，再用 --env-file .env.docker 启动
#
# ⚠️ 此文件是**唯一**该放密钥的地方，且已被 .gitignore + .dockerignore 排除：
#    不进 git，也不进镜像层（镜像层可被任何拿到镜像的人读取）。
#
# 生成强随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# --- 运行环境 ---
NODE_ENV=production
PORT=3000
# 宿主机映射端口（compose 用，容器内始终是 3000）
APP_PORT=3000

# --- 数据库 ---
# DB_HOST/DB_PORT 由 compose 覆盖成容器网络里的 mysql:3306，这里写什么都会被替换
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=nodeservers
DB_USER=nodeservers
DB_PASS=change-me-db-password
# 仅 MySQL 容器初始化时需要（compose 的 ${DB_ROOT_PASS:?} 会校验它存在）
DB_ROOT_PASS=change-me-root-password

# --- Redis ---
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
# 容器内网默认不开密码；若宿主机也暴露 6379，请务必设置并同步进 REDIS_PASSWORD
REDIS_PASSWORD=

# --- 安全密钥（**全部必须替换**，生产环境缺失/占位值会导致启动校验失败）---
APP_SECRET=change-me-to-a-random-string
SESSION_SECRET=change-me-to-a-random-string
FIREWALL_SECRET=change-me-to-a-random-string
SIGN_APP_KEY=change-me-to-a-random-string
# 手机号加密密钥（32 位十六进制字符串 = 16 字节）
PHONE_ENCRYPT_KEY=

# --- 私钥信封加密（AES-256-GCM）---
# 数据库里的 JWT 签名私钥是否以密文存储。留空 = 继续明文（不推荐）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 配置后运行 node scripts/migrate-key-encryption.js 把历史明文迁成密文。
# KEY_ENCRYPTION_KEY=
# 当前密钥标识（轮转时换新 ID；旧密文靠下面两行继续解）
# KEY_ENCRYPTION_KEY_ID=k1
# 轮转期间保留的旧密钥（只解密，不再用于加密）
# KEY_ENCRYPTION_KEY_PREVIOUS=
# KEY_ENCRYPTION_KEY_PREVIOUS_ID=k0
# 置 true 时缺少 KEY_ENCRYPTION_KEY 直接拒绝启动（生产建议开启）
# KEY_ENCRYPTION_REQUIRED=false

# --- 跨域 / 外部地址 ---
# 生产**必须**填：留空时 origin-guard 是 fail-closed，所有敏感端点（bind-session /
# switch-account）直接拒绝。无尾斜杠、含协议、子域要逐个列出。
CORS_ORIGINS=https://your-domain.com
# OAuth 签发者根地址（OIDC 发现文档与 JWT iss），需与对外访问地址一致
ISSUER=https://your-domain.com/oauth2.1
# 跨子域共享 Cookie 时填 .your-domain.com；单域留空
COOKIE_DOMAIN=

# --- 反向代理信任（只有前面真的挂了 Nginx / Cloudflare / ALB 才填）---
#
# ⚠️ 这一项填得越宽，IP 维度防护越接近关闭。被信任网段里的任何来源都可以自定义
#    `X-Forwarded-For`，而 `request.ip` 正是下面三件事的**唯一**判据：
#      · allowIps 接口白名单        （src/api/guard.js）
#      · 全局限流 keyGenerator      （rate:ip:*）
#      · 防火墙按 IP 的封禁 / 挑战  （fw:blocked:ips）
#    所以这里**只能填反向代理的确切地址**，绝不要填整个内网网段
#    （历史默认值 172.16.0.0/12 覆盖 100 万个地址 = 把 IP 维度直接让给攻击者）。
#
# 查代理容器的确切地址：
#   docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' <nginx容器名>
# 然后把结果写成 <ip>/32；多个代理用逗号分隔。容器 IP 重建后会变，建议在 compose 里
# 给代理固定 ipv4_address，或改用 unix socket / 宿主回环（127.0.0.1，默认值）。
#
# 例：PROXY_TRUST_CIDR=172.18.0.2/32,127.0.0.1
# 不给该项时默认只信任 127.0.0.1 / ::1 —— 单机反代同宿主时这就是正确配置。
PROXY_TRUST_CIDR=127.0.0.1

# --- 超级管理员（首次 `setup:admin` 用；建完可删掉这两行）---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password

# --- 容器启动行为 ---
# entrypoint 是否等待 DB / Redis 可达（true/false）
WAIT_FOR_DEPS=true
# 依赖等待上限（毫秒）。超过则 DB 直接失败退出、Redis 告警后继续（降级）
DEP_WAIT_TIMEOUT_MS=90000
# 是否在容器启动时跑迁移。**多副本务必保持 false**，迁移用独立的 migrate 服务
RUN_MIGRATIONS=false

# --- 邮件（验证码 / 通知，留空则相关功能静默跳过）---
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_email@163.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Your App <your_email@163.com>"
SMTP_USE_SSL=true

# --- 人机验证（按需）---
RECAPTCHA_ENABLED=false
RECAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- 日志 ---
# 生产默认 info；排查问题可临时 debug
LOG_LEVEL=info
# 容器内按 PID 区分文件名，多副本 / 重启时日志不会交错
LOG_FILE_SUFFIX=pid
# 滚动日志保留天数（0 = 永久保留，容器里建议设上限）
LOG_KEEP_DAYS=30

# oauth21 安全钩子（CSRF + 敏感接口限频）：留空/on = 启用（默认），off = 应急关闭
# 仅在"前端版本落后于后端、老 bundle 不带 x-csrf-token 导致登录 403"时临时置 off
# OAUTH21_SECURITY_HOOKS=on
