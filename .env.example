# ================================================================
# 环境配置文件模板
# 复制此文件为 .env 并修改对应值
# ================================================================

# --- 系统基础配置 ---
# 运行环境：development / production / test
NODE_ENV=development
# 服务监听端口
PORT=3000
# 慢请求告警阈值（毫秒）已迁 src/config/app_config.js（monitor.slowRequestThresholdMs）
# 反向代理信任网段（逗号分隔，如 Nginx / Cloudflare / ALB）
# ⚠️ 只能填反向代理的**确切地址**（如 172.18.0.2/32）：被信任网段里的任何来源都能自定义
#    X-Forwarded-For，而 request.ip 是 IP 白名单 / 限流 / 封禁的唯一判据。默认只信任回环。
# PROXY_TRUST_CIDR=127.0.0.1,::1
# ↓ HTTP/WS 三个超时调优项已迁到 src/config/app_config.js（带注释，改完重启生效）。

# --- 数据库配置 (SQL) ---
# 数据库类型：mysql / postgres / sqlite
DB_TYPE=mysql
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库名称
DB_NAME=your_database_name
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASS=your_password
# 连接池调优（max/min/acquire/idle）已迁 src/config/db_config.js 的 pool 段，
# 该文件可整目录删除（默认值在 framework/db/index.js）。env 不再读取。


# --- Redis 配置 ---
DEBUG_REDIS= true
# 是否启用 Redis（true/false），启用后用于 Session 存储、限流、Nonce 去重等
REDIS_ENABLED=false
# Redis 主机地址
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码（留空表示无密码）
REDIS_PASSWORD=
# Redis 默认数据库编号（0-15），默认 0
# REDIS_DB=0
# 备用 Redis 主机地址（可选，主库失效时自动切换）
# REDIS_BACKUP_HOST=
# 备用 Redis 端口（默认 6379）
# REDIS_BACKUP_PORT=6379
# 是否启用 TLS 加密连接（true/false）
# REDIS_TLS=false
# TLS 端口模式与自定义 CA
# REDIS_TLS_CA=
# 默认校验证书；仅在本地自签名调试时临时置 true，生产严禁
REDIS_TLS_SKIP_VERIFY=false
# Redis ACL 用户名（Redis 6+，可选；密码单独用 REDIS_PASSWORD）
# REDIS_USERNAME=
# 连接超时 / 重连次数 / 单命令超时已迁 src/config/redis_config.js（env 不再读取）

# --- 手机号加密 ---
# 手机号加密密钥（32 位十六进制字符串），用于加密存储用户手机号
# PHONE_ENCRYPT_KEY=

# --- 私钥信封加密（AES-256-GCM）---
# 数据库里的 JWT 签名私钥是否以密文存储。留空 = 继续明文（不推荐）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 配置后运行 node scripts/migrate-key-encryption.js 把历史明文迁成密文。
# KEY_ENCRYPTION_KEY=
# 当前密钥标识（轮转时换新 ID；旧密文靠下面两行继续解）
# KEY_ENCRYPTION_KEY_ID=k1
# 轮转期间保留的旧密钥（只解密，不再用于加密）
# KEY_ENCRYPTION_KEY_PREVIOUS=
# KEY_ENCRYPTION_KEY_PREVIOUS_ID=k0
# 置 true 时缺少 KEY_ENCRYPTION_KEY 直接拒绝启动（生产建议开启）
# KEY_ENCRYPTION_REQUIRED=false

# --- 对象存储 (OSS) ---
# OSS 访问密钥 ID
# OSS_ACCESS_KEY_ID=
# OSS 访问密钥 Secret
# OSS_ACCESS_KEY_SECRET=
# OSS 存储桶名称
# OSS_BUCKET=
# OSS 地域（如 oss-cn-hangzhou）
# OSS_REGION=oss-cn-hangzhou
# OSS 访问端点（可选，默认自动拼接）
# OSS_ENDPOINT=
# OSS 自定义域名（可选，用于 CDN 加速）
# OSS_CUSTOM_DOMAIN=

# --- 安全与加密 ---
# JWT 签名密钥（必须使用强随机字符串，生产环境强制校验）
APP_SECRET=change-me-to-a-random-string
# Session Cookie HMAC 签名密钥（用于防篡改）
SESSION_SECRET=change-me-to-a-random-string
# 防火墙密钥（用于签名验证）
FIREWALL_SECRET=change-me-to-a-random-string
# JWT 模式开关已迁 src/config/auth_config.js 的 jwt.enabled（唯一来源：
# framework 的 bearer 校验与 oauth21 的签发共用）。env 不再读取。
# 每用户最大 refresh token 数见 src/config/auth_config.js 的 session.maxRefreshTokens。

# --- 服务间地址与外部依赖（部署拓扑，必须按环境填）---
# 前端站点基地址（拼接回调 / 邮件链接等）
# API_BASE_URL=https://api.example.com
# 单点登录服务地址（与 oauth21 对接）
# SSO_URL=https://sso.example.com
# 旧版 JWT 兼容密钥（存量 token 验签用；新体系走 framework/keys 的 RSA 密钥对）
# JWT_SECRET=
# 跨子域 Cookie 安全属性（生产 HTTPS 必须 true）
# COOKIE_SECURE=true
# Cookie SameSite：lax（默认，同站）/ none（真跨站，必须配合 COOKIE_SECURE=true）
# COOKIE_SAMESITE=lax
# RetroWeb 上游依赖（仅部署 retroweb 应用时需要）
# RETRO_PYTHON_URL=http://127.0.0.1:8000
# RETROWEB_OFFICIAL_LLM_ENABLED=false
# RETROWEB_OFFICIAL_LLMS=

# --- CORS 跨域配置 ---
# 允许的跨域来源（逗号分隔，无空格，无尾斜杠，必须含协议 http:// 或 https://）
#
# 一值两用：
#  1) @fastify/cors 跨域白名单 —— 浏览器跨域请求带 Cookie 的来源校验
#  2) origin-guard（src/framework/auth/origin-guard.js）—— bind-session / bind-token
#     / switch-account 等敏感端点的 Origin 白名单，防止一次性凭证(session_token)泄露后
#     被非授权域消费
#
# 规则：
#  - 必须列出所有会调 /auth/v1/bind-session、/auth/v1/switch-account 的前端域
#  - 子域不自动通配：posecraft.your.com 和 www.posecraft.your.com 要分别列
#  - 无尾斜杠（new URL().origin 不带尾斜杠，带斜杠会匹配失败）
#  - 生产环境留空 → origin-guard fail-closed，所有敏感端点请求被拒并告警
#  - 开发环境留空 → 放行所有来源（便于本地跨端口调试）
#
# 开发环境示例（按 vite 实际端口对齐）：
#   CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# 额外允许的请求头（逗号分隔，**只增不减**；留空 = 只放开内置清单，安全默认不变）
# 用途：前端新增自定义头（如 x-trace-id / x-tenant）时，不必改代码即可放行。
#   🔴 漏配一个头 = 该链路跨域直连时预检失败，前端只会看到 Network Error（无其他线索）
CORS_EXTRA_HEADERS=
# 生产环境示例：
#   CORS_ORIGINS=https://posecraft.your-domain.com,https://oauth21.your-domain.com,https://firewall.your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=

# --- SMTP 邮件配置 ---
# SMTP 服务器地址
SMTP_SERVER=smtp.163.com
# SMTP 端口（SSL: 465, TLS: 587）
SMTP_PORT=465
# SMTP 用户名
SMTP_USER=your_email@163.com
# SMTP 授权码/密码
SMTP_PASSWORD=your_smtp_password
# 发件人显示名称
SMTP_FROM="Your App <your_email@163.com>"
# 是否使用 SSL（端口 465 必选 true）
SMTP_USE_SSL=true

# --- 业务逻辑开关 ---
# 启动时是否自动同步表结构（true/false）
# 仅限首次开发环境建表使用，生产环境必须用 npm run migrate
DB_SYNC=false

# oauth21 安全钩子（CSRF + 敏感接口限频）：留空/on = 启用（默认），off = 应急关闭
# 仅在"前端版本落后于后端、老 bundle 不带 x-csrf-token 导致登录 403"时临时置 off
# OAUTH21_SECURITY_HOOKS=on

# --- 超级管理员初始化 ---
# 首次运行 npm run setup:admin 时，如果用户不存在会自动创建
# 留空则使用系统中第一个注册的用户
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=your-strong-password

# --- Token 有效期 / 会话上限（已迁 src/config/oauth21_config.js）---
# tokens.accessTokenTTL / tokens.refreshTokenTTL / tokens.idTokenTTL、
# authorizationCode.ttl、session.maxSessionsPerApp 均在该文件或
# src/data/oauth21_config.json（热改）中调整（注意：TTL 不归 jwt 组，
# 默认 Session 模式同样生效）；
# 每用户 refresh token 上限见 src/config/auth_config.js 的 session.maxRefreshTokens。
# OAuth 签发者 URL（OIDC 发现文档 & JWT iss claim，须为授权服务器实际根，含 /oauth2.1 前缀）
# ISSUER=http://localhost:3000/oauth2.1
# 跨子域 Cookie domain（抖音式多账号：device_id/accounts cookie 跨子域共享；生产如 .your.com，空=host-only）
# COOKIE_DOMAIN=

# ================================================================
# 验证模块配置
# ================================================================

# --- 图形验证码（已迁 src/config/verify_config.js 的 captcha 段）---
# 字符数 / 干扰线 / TTL / 续期 / 失败上限均可在该文件或
# src/data/verify_config.json（热改）中调整

# --- 设备指纹（已迁 src/config/verify_config.js 的 device 段）---
# enabled / fingerprintFields 在该文件或 src/data/verify_config.json（热改）中调整。
# 默认关闭：仅用 IP+UA 绑定验证码/consentKey；开启后前端注入 X-Device-Fp 参与计算

# --- 短信验证码 ---
# 短信服务商：aliyun / tencent
SMS_PROVIDER=aliyun
# 阿里云/腾讯云 AccessKey ID
SMS_ACCESS_KEY_ID=
# 阿里云/腾讯云 AccessKey Secret
SMS_ACCESS_KEY_SECRET=
# 短信签名（需在服务商后台申请）
SMS_SIGN_NAME=
# 短信模板编码（需在服务商后台申请）
SMS_TEMPLATE_CODE=
# 码长 / 有效期 / 发送频率已迁 src/config/verify_config.js 的 sms 段
# （或 src/data/verify_config.json 热改保留码长不变，改完无需重启）

# --- 人机验证（hCaptcha / Google reCAPTCHA）---
# 开关 / 服务商 / 分数阈值 / 预期域名与动作已迁 src/config/verify_config.js 的
# recaptcha 段（src/data/verify_config.json 可热改）。
#   - google:    Google reCAPTCHA v3（分数制）
#   - hcaptcha:  hCaptcha（国内访问可用，但加载 200-500KB 较慢）
#   - turnstile: Cloudflare Turnstile（推荐国内场景，SDK ~50KB，加载快）
# 后端校验密钥（从服务商后台获取，**绝不能提交到 git**）
RECAPTCHA_SECRET_KEY=
# 前端站点密钥（从服务商后台获取，绑定你的域名）
RECAPTCHA_SITE_KEY=
# reCAPTCHA v3 最低分数已迁 src/config/verify_config.js 的 recaptcha.minScore（env 不再读取）

# ===== Cloudflare Turnstile 独立配置（provider='turnstile' 时使用）=====
# 推荐国内/隐私场景。Turnstile 与 hCaptcha/reCAPTCHA API 不兼容，需单独配。
# 启用：provider=turnstile + RECAPTCHA_ENABLED=true + 下面两项有值
#   - SECRET_KEY: Cloudflare Dashboard → Turnstile → 你的 widget → "Secret Key"
#   - SITE_KEY:  同上 → "Site Key"（公开 key，可放前端 .env）
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# 前端配置（oauth21/.env）：
#   VITE_RECAPTCHA_ENABLED=true（与后端 RECAPTCHA_ENABLED 对应）
#   VITE_RECAPTCHA_SITE_KEY=<同后端 SITE_KEY>（hCaptcha 用）
#   VITE_TURNSTILE_ENABLED=true（Turnstile 启用）
#   VITE_TURNSTILE_SITE_KEY=<同后端 SITE_KEY>（Turnstile 用）

# --- 滑块 / 扫码 / 通用（已迁 src/config/verify_config.js）---
# slider.tolerance / slider.ttl / qrcode.ttl / qrcode.pollInterval /
# common.rateLimit / common.codeTtl 均在该文件或 src/data/verify_config.json（热改）中调整

# --- 密码重置方式（二选一） ---
# code：验证码重置（默认）— 邮箱码校验后改密码
# link：邮件链接重置 — 发一次性 reset token 邮件，点链接改密码
# 前端 oauth21/.env 的 VITE_PASSWORD_RESET_MODE 需与此一致
PASSWORD_RESET_MODE=code

# ================================================================
# 防火墙调优（已迁出 env，2026-11-03）
# ================================================================
# 阈值/开关类调优项不再走环境变量：默认值见 src/framework/firewall/config/defaults.js，
# 运行时修改走 src/data/firewall_config.json（deepMerge 覆盖 + 管理面板热改，
# 数组为整体替换）。仅剩两个特例 env：
# FW_RATE_LIMIT_OVERRIDE=       # 压测纯放宽旁路（只能抬高阈值，见 first-ratelimit.js）
# FW_TRAFFIC_STATS_FILE=        # 统计文件路径覆盖（仅测试隔离用）

# --- 请求签名 appKey（前后端共享，前端 .env 的 VITE_SIGN_APP_KEY 必须相同）---
SIGN_APP_KEY=change-me-to-a-random-string

# --- 日志系统（wb-logkit，完整变量见 src/framework/log/README.md）---
# LOG_LEVEL=info                # 全局最低级别（trace/debug/info/warn/error/fatal）
# LOG_DEBUG=                    # debug/trace 白名单关键词（逗号分隔，'*' 全开）
# LOG_MAX_STR=2000              # 单字段字符串长度上限（字符数），0 = 关闭截断
# LOG_FILE_SUFFIX=              # 日志文件名后缀；pid = 进程号（多进程部署防行交错）
# LOG_KEEP_DAYS=30              # 滚动日志保留天数，0 = 永久保留
# LOG_PRETTY=                   # 控制台彩色可读输出（默认非 production 开启）

# --- 资源闸门（已迁 src/config/app_config.js 的 passwordHash 段）---
# scrypt / bcrypt 并发上限改见 passwordHash.scryptMaxConcurrency / bcryptMaxConcurrency
